# Mini Loihi SNN Processor — Yosys Synthesis Script
# Target: Sky130 standard cell library
#
# RTL uses SystemVerilog (unpacked array ports, '0 literals), so read with -sv.

# Read all RTL sources
read_verilog -sv hardware/rtl/timestep_ctrl.v
read_verilog -sv hardware/rtl/weight_rom.v
read_verilog -sv hardware/rtl/synapse_acc.v
read_verilog -sv hardware/rtl/lif_core.v
read_verilog -sv hardware/rtl/spike_router.v
read_verilog -sv hardware/rtl/snn_top.v

# Elaborate and check
hierarchy -check -top snn_top
proc
opt

# Technology-independent synthesis
synth -top snn_top

# Report pre-mapping stats
stat

# Write generic netlist (no PDK needed for this step)
write_verilog -noattr physical/synth/snn_top_synth.v

# Optional: if Sky130 lib is available, enable this:
# dfflibmap -liberty path/to/sky130_fd_sc_hd__tt_025C_1v80.lib
# abc -liberty path/to/sky130_fd_sc_hd__tt_025C_1v80.lib
# write_verilog physical/synth/snn_top_mapped.v
